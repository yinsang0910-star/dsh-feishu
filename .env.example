# 飞书自建应用凭据（必填）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认会话：不指定 target 时往这里发。聊天群/单聊的 chat_id（oc_ 开头）
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：Lark 国际版用 https://open.larksuite.com
# FEISHU_DOMAIN=https://open.feishu.cn

# 可选：默认接收方 id 类型，chat_id | open_id | email | user_id | union_id
# FEISHU_DEFAULT_RECEIVE_ID_TYPE=chat_id
