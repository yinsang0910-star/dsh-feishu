{
  "name": "dsh-feishu",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Feishu/Lark as an operating surface for DeepSeek Harness — MCP server + plugin",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @yisang0910/core build",
    "build:single": "pnpm build && esbuild packages/mcp/src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-single/dsh-feishu-mcp.mjs --log-level=warning",
    "typecheck": "pnpm build:core && pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:channel && pnpm test:bot",
    "smoke": "node scripts/smoke.mjs",
    "smoke:write": "node scripts/smoke.mjs --write",
    "dev": "pnpm --filter @yisang0910/mcp dev",
    "test:channel": "node channel/test/selfcheck.mjs && node --test channel/lib/*.test.mjs",
    "test:bot": "python3 -m unittest discover -s services/feishu-bot -p \"test_*.py\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  }
}
