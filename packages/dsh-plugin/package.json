{
  "name": "@dsh-feishu/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 的飞书连接设置页：表单填 App ID / Secret / 默认会话，测试连接、保存并启用（写 feishu.env + profile patch 的 MCP 行）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT"
}
